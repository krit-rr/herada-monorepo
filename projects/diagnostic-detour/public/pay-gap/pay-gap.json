{
 "title": "Procedure Pay Gap Explorer",
 "lede": "What Medicare assigns to matched procedures on female and male anatomy, from the public 2026 physician fee schedule. Pairs from the published literature are marked as such; the rest are Herada's own proposals, listed so they can be checked, not because they have been.",
 "status": "Draft. Held back until the pair review against Penn et al. (2025) and a clinician's check are done.",
 "compiled_by": "Krit, with Herada tooling, 2026-11-03",
 "as_of": "2026-11-03",
 "groups": {
  "same": "One operation, two codes: the CPT code itself names the sex. The cleanest comparison there is, because the specialty, the setting and the operation are the same.",
  "published": "Pairs from Goff, Muntz and Cain (1997), as re-used by Polan and Barber (2021). Matched for anatomic and technical similarity by the original authors.",
  "proposed": "Herada's own anatomically matched pairs, not yet reviewed by a clinician. Each carries a match strength and the reason for it.",
  "popular": "A comparison that circulates widely but is not a fair pair. Shown with its numbers so the mismatch is visible."
 },
 "literature": [
  {
   "year": 1997,
   "authors": "Goff BA, Muntz HG, Cain JM",
   "title": "Comparison of 1997 Medicare relative value units for gender-specific procedures: is Adam still worth more than Eve?",
   "journal": "Gynecologic Oncology 1997;66(2):313-319",
   "url": "https://doi.org/10.1006/gyno.1997.4775",
   "pmid": "9264582",
   "finding": "24 matched pairs, 1997 values. The male-specific procedure carried the higher work RVU in 19 (80%) and the higher total RVU in 20 (83%); work RVUs averaged 49% higher and reimbursement 37% higher for the male-specific procedure."
  },
  {
   "year": 2017,
   "authors": "Benoit MF, Ma JF, Upperman BA",
   "title": "Comparison of 2015 Medicare relative value units for gender-specific procedures: gynecologic and gynecologic-oncologic versus urologic CPT coding. Has time healed gender-worth?",
   "journal": "Gynecologic Oncology 2017;144(2):336-342",
   "url": "https://doi.org/10.1016/j.ygyno.2016.12.006",
   "pmid": "28024653",
   "finding": "50 matched pairs, 2015 values. The male-specific procedure carried higher work and total RVUs in 36 (72%) and a higher fee in 42 (84%); male-specific surgeries averaged 27.67% higher reimbursement."
  },
  {
   "year": 2021,
   "authors": "Polan RM, Barber EL",
   "title": "Reimbursement for female-specific compared with male-specific procedures over time",
   "journal": "Obstetrics & Gynecology 2021;138(6):878-883",
   "url": "https://doi.org/10.1097/AOG.0000000000004599",
   "pmid": "34736273",
   "finding": "12 of the 1997 pairs, with operating times from the NSQIP registry. The male-specific procedure carried the higher RVU in 9 of 12 pairs in 1997 and 6 of 12 in 2015. Per hour of operating, female-specific procedures earned more RVUs (10.6 vs 9.7) but fewer dollars ($555 vs $599), because specialties are paid different amounts per RVU."
  },
  {
   "year": 2025,
   "authors": "Penn M, Colley D, Koirala P, King L, Fitzgerald J",
   "title": "Price and prejudice: reimbursement of surgical care on male versus female anatomies",
   "journal": "Journal of Women's Health 2025;34(5):665-676",
   "url": "https://doi.org/10.1089/jwh.2024.0984",
   "pmid": "39978776",
   "finding": "55 anatomically matched procedures (110 CPT codes), 2023 values, pairs verified by gynecologists and urologists. The female-anatomy procedure had the lower RVU in 41 (75%); male-anatomy RVUs averaged 30% higher; facility reimbursement was higher for the male procedure in 35 (64%), by 25.6% on average. Across 2003 to 2023 the average male advantage stayed at 31 to 34%."
  }
 ],
